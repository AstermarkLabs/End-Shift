# Copy to .env.local (or export directly) for local dev. Never commit real values.

# Required
DATABASE_URL=postgres://user:password@localhost:5432/end_shift
PORT=8080

# Auth — has dev-only deterministic fallbacks; REQUIRED (>=16 chars) in production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# WebAuthn / passkeys — defaults target localhost web dev
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost
WEBAUTHN_RP_NAME=End Shift

# Native passkey support (iOS/Android) — only needed for fingerprint/Face ID
WEBAUTHN_ANDROID_SHA256=
WEBAUTHN_ANDROID_PACKAGE=
WEBAUTHN_IOS_TEAM_ID=
WEBAUTHN_IOS_BUNDLE_ID=
