# Copy to .env.local (or export directly) for local dev. Never commit real values.

# Required
DATABASE_URL=postgres://user:password@localhost:5432/end_shift
PORT=8080

# Auth — has dev-only deterministic fallbacks; REQUIRED (>=16 chars) in production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encrypts personal-information fields (email, displayName) at rest — see
# fieldCrypto.ts and HANDOFF-e2ee.md. Same dev-only deterministic fallback
# convention as the JWT secrets above; REQUIRED (>=16 chars) in production.
# FIELD_ENCRYPTION_KEY is an alias for FIELD_ENCRYPTION_KEY_V1 (the first
# key version) — kept so already-deployed environments don't need renaming.
FIELD_ENCRYPTION_KEY=

# Separate, stable secret for the email duplicate-check blind index
# (hashForLookup). Deliberately independent from FIELD_ENCRYPTION_KEY_V* —
# rotating the AES key must never change existing emailHash values.
# REQUIRED (>=16 chars) in production; do not reuse FIELD_ENCRYPTION_KEY here.
FIELD_INDEX_KEY=

# Key rotation (optional — omit both unless actively rotating):
#   1. Set FIELD_ENCRYPTION_KEY_V2 (or V3, ...) to a new key.
#   2. Set FIELD_ENCRYPTION_ACTIVE_KEY_VERSION to that number — new writes
#      use it immediately; existing rows keep decrypting under their own
#      embedded version until rotated forward.
#   3. Run `pnpm run rotate:pii-key` (see rotateFieldEncryptionKey.ts) to
#      move existing rows onto the new version, then retire the old key.
# FIELD_ENCRYPTION_KEY_V2=
# FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=1

# WebAuthn / passkeys — localhost is the development default. Replit-hosted
# previews use their supplied HTTPS domain; production defaults to
# end-shift.replit.app to match the EAS app association. Override both values
# when deploying to a custom domain.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost
WEBAUTHN_RP_NAME=End Shift

# Native passkey support (iOS/Android) — the checked-in Android debug key is
# used automatically outside production. Set this to the release certificate
# fingerprint in production (and include both fingerprints, comma-separated,
# during a signing transition).
WEBAUTHN_ANDROID_SHA256=
WEBAUTHN_ANDROID_PACKAGE=
WEBAUTHN_IOS_TEAM_ID=
WEBAUTHN_IOS_BUNDLE_ID=
