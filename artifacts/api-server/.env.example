# Copy to .env.local (or export directly) for local dev. Never commit real values.

# Required
DATABASE_URL=postgres://user:password@localhost:5432/end_shift
PORT=8080

# Auth — has dev-only deterministic fallbacks; REQUIRED (>=16 chars) in production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# WebAuthn / passkeys — localhost is the development default. Replit-hosted
# previews use their supplied HTTPS domain; production defaults to
# end-shift.replit.app to match the EAS app association. Override both values
# when deploying to a custom domain.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost
WEBAUTHN_RP_NAME=End Shift

# Native passkey support (iOS/Android) — the checked-in Android debug key is
# used automatically outside production. Set this to the release certificate
# fingerprint in production (and include both fingerprints, comma-separated,
# during a signing transition).
WEBAUTHN_ANDROID_SHA256=
WEBAUTHN_ANDROID_PACKAGE=
WEBAUTHN_IOS_TEAM_ID=
WEBAUTHN_IOS_BUNDLE_ID=
