{
  "expo": {
    "name": "End Shift",
    "slug": "checklist",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "checklist",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C8102E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.theappfoundry.endshift",
      "associatedDomains": [
        "webcredentials:REPLACE_WITH_YOUR_DOMAIN"
      ]
    },
    "android": {
      "package": "com.theappfoundry.endshift"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "compileSdkVersion": 35,
            "minSdkVersion": 28
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0496298b-7995-4a1a-b834-1d0ec1c9ed89"
      }
    }
  }
}
